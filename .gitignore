/native/mozjpeg/macos/*
/native/mozjpeg/macos/*/*
/native/mozjpeg/windows/*
!/native/mozjpeg/macos/arm64/
!/native/mozjpeg/macos/arm64/.gitkeep
!/native/mozjpeg/macos/x86_64/
!/native/mozjpeg/macos/x86_64/.gitkeep
!/native/mozjpeg/windows/.gitkeep
